generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id         String      @id @default(cuid())
  name       String
  costPrice  Float
  salePrice  Float       @default(0)
  stock      Int         @default(0)
  movements  Movement[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Movement {
  id        String   @id @default(cuid())
  type      String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  total     Float
  cupomId   String?
  clientName String?
  createdAt DateTime @default(now())
}
