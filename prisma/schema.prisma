generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        String      @id @default(cuid())
  name      String
  stock     Int         @default(0)
  entries   Entry[]
  movements Movement[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Entry {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitCost  Float
  total     Float
  cupomId   String?
  createdAt DateTime @default(now())
}

model Movement {
  id          String   @id @default(cuid())
  type        String
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Float
  averageCost Float?
  total       Float
  cupomId     String?
  clientName  String?
  createdAt   DateTime @default(now())
}
